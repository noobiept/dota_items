{
    "name": "dota_items",
    "version": "2.2.0",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "dependencies": {
        "@drk4/game-engine": "^2.0.0",
        "@drk4/utilities": "^6.3.2"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "eslint": "^10.2.1",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.0",
        "vite": "^8.0.10"
    },
    "prettier": {
        "tabWidth": 4
    },
    "scripts": {
        "dev": "vite",
        "build": "pnpm run typecheck && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint scripts/**"
    }
}
